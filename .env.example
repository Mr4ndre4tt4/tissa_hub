# Configuração pública da Central de Chamados.
# Não são segredos, mas também não devem ser inventados: sem valores reais o
# aplicativo exibe "Integração Microsoft não configurada" e oferece apenas o
# modo demonstrativo.

# Client ID do registro de aplicativo Microsoft com suporte a conta pessoal.
VITE_MS_CLIENT_ID=

# Autoridade de consumidores (conta Microsoft pessoal).
VITE_MS_AUTHORITY=https://login.microsoftonline.com/consumers

# Redirect URI, idêntico ao cadastrado no registro do aplicativo.
VITE_MS_REDIRECT_URI=

# Endereço HTTPS publicado da interface.
VITE_APP_URL=
