{
  "name": "central-de-chamados",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "description": "Central de Chamados — controle pessoal de chamados e esforço, com dados no OneDrive pessoal.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "baseline": "tsx scripts/verificar-baseline.ts",
    "verificar:interface": "node scripts/verificar-interface.mjs",
    "test:restrito": "vitest run --config vitest.restrito.config.ts"
  },
  "dependencies": {
    "@azure/msal-browser": "3.28.1",
    "fflate": "0.8.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "26.1.0",
    "playwright": "1.63.0",
    "tsx": "4.23.13",
    "typescript": "5.6.3",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  }
}
