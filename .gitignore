# Insumos privados do cliente — nunca versionar, nunca publicar, nunca entrar no build.
insumos_privados/
**/*.xlsm
**/*.xlsx
private-fixtures/
exports/
recovery/

# Configuração real (client ID, redirect URI, URL publicada).
.env
.env.*
!.env.example

# Dependências e build
node_modules/
dist/
coverage/

# Logs e resultados de teste — revisar antes de publicar.
*.log
playwright/.auth/
test-results/

# Pacote da especificação e contratos derivados do arquivo real.
# O repositório é PÚBLICO e esses documentos citam números de chamado e
# estatísticas de trabalho do cliente. Ficam fora do controle de versão; os
# contratos que o código realmente consome estão em contratos/, sem dado real.
especificacao/
